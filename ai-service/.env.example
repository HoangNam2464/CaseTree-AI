# ==============================================================================
# CaseTree AI — FastAPI AI Service Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ==============================================================================

# Internal API key (must match Spring Boot''s AI_SERVICE_API_KEY)
AI_SERVICE_API_KEY=changeme_internal_ai_service_api_key

# Debug mode (enables Swagger UI at /docs)
DEBUG=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=casetree_ai
POSTGRES_USER=casetree
POSTGRES_PASSWORD=changeme_db_password

# Active LLM provider: openai | gemini
AI_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=sk-changeme
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# RAG
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# Debate
DEBATE_MAX_ROUNDS=2
