# ==============================================================================
# Edu-Branch-AI — Frontend Environment Configuration
# ==============================================================================
# RULE: NEVER store server secrets, API keys, or passwords in frontend env vars.
# Only public, frontend-safe values belong here.
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.
# ==============================================================================

# NestJS Backend API Gateway URL (frontend calls this — NEVER FastAPI directly)
VITE_API_BASE_URL=http://localhost:8080/api/v1
