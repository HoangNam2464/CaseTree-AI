# ==============================================================================
# EduBranch AI — Master Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:
#        cp .env.example .env       (Linux/macOS)
#        copy .env.example .env     (Windows)
#   2. Fill in your actual values below.
#   3. NEVER commit the actual .env file to Git.
#   4. Rotate secrets immediately if they are accidentally exposed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Active profile: development | staging | production
APP_ENV=development

# Backend Gateway Port (NestJS)
SERVER_PORT=8080

# FastAPI AI Service Port (INTERNAL — do not expose to the public internet)
FASTAPI_PORT=8000

# React Frontend Development Server Port
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 2. DATABASE — PostgreSQL + pgvector
# ------------------------------------------------------------------------------
# Use 'localhost' for local dev outside Docker; 'postgres' inside Docker network
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edubranch_ai
POSTGRES_USER=edubranch
POSTGRES_PASSWORD=changeme_db_password

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE — MinIO
# ------------------------------------------------------------------------------
# Use 'localhost' for local dev outside Docker; 'minio' inside Docker network
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password

# Bucket names
MINIO_BUCKET_MATERIALS=edubranch-materials

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION — JWT
# ------------------------------------------------------------------------------
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=changeme_generate_a_strong_random_jwt_secret_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 5. AI PROVIDERS — LLM Configuration
# ------------------------------------------------------------------------------
# Set ONE or BOTH providers. The active provider is controlled by the
# AI_PROVIDER variable below.

# Active LLM provider: openai | gemini
AI_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=sk-changeme-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=changeme-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 6. INTERNAL SERVICE COMMUNICATION
# ------------------------------------------------------------------------------
# Backend Gateway calls FastAPI via this URL (internal Docker network)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=changeme_internal_ai_service_api_key

# ------------------------------------------------------------------------------
# 7. CORS & ALLOWED ORIGINS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 8. DOCUMENT PROCESSING
# ------------------------------------------------------------------------------
# Max upload size per file (in MB)
MAX_UPLOAD_SIZE_MB=50

# Allowed MIME types for teaching material uploads
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ------------------------------------------------------------------------------
# 9. RAG CONFIGURATION
# ------------------------------------------------------------------------------
# Chunk size for document splitting (tokens/characters, configure in ai-service)
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ------------------------------------------------------------------------------
# 10. DEBATE ASSISTANT
# ------------------------------------------------------------------------------
# Maximum debate rounds per decision node
DEBATE_MAX_ROUNDS=2
# ------------------------------------------------------------------------------
# 11. REDIS CACHE & SESSION STORE
# ------------------------------------------------------------------------------
# Use 'localhost' for local dev outside Docker; 'redis' inside Docker network
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
